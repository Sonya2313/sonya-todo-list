{
  "manifest_version": 3,
  "name": "Axiom Wallet Monitor",
  "version": "1.0.0",
  "description": "Axiom trade history and fresh-wallet monitor",

  "permissions": ["tabs", "storage"],

  "host_permissions": [
    "https://axiom.trade/*",
    "https://api.axiom.trade/*",
    "https://api3.axiom.trade/*",
    "https://freshscanner-production.up.railway.app/*"
  ],

  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },

  "action": {
    "default_title": "Open Axiom trades"
  },

  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*"],
      "js": ["src/content.ts"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
